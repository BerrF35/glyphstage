{
  "name": "glyphstage",
  "private": true,
  "version": "2.1.0",
  "description": "Real-time WebGL2 3D multi-medium studio — 60 procedural worlds, incompressible Navier-Stokes fluid, 10 ASCII text-mode styles, and 21 painterly, ink, print, analog, mosaic, glitch, and optical shaders",
  "homepage": "https://berrf35.github.io/glyphstage/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
